<style>
:root{
  --ink:#10221f;
  --paper:#f1f4f2;
  --card:#ffffff;
  --pine:#14554a;
  --pine-deep:#0d3d35;
  --amber:#e7a13b;
  --amber-soft:#f7e3c2;
  --mist:#dbe4e0;
  --slate:#4e5f5a;
  --radius:18px;
  --font-display:"Bricolage Grotesque",sans-serif;
  --font-body:"Instrument Sans",sans-serif;
  --font-mono:"JetBrains Mono",monospace;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:var(--font-body);
  background:var(--paper);
  color:var(--ink);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--amber-soft)}

.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
section{padding:96px 0}
h1,h2,h3{font-family:var(--font-display);line-height:1.08;letter-spacing:-0.01em}
a{color:inherit}

.eyebrow{
  font-family:var(--font-mono);font-size:12px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--pine);display:flex;align-items:center;gap:10px;
}
.eyebrow::before{content:"";width:26px;height:2px;background:var(--amber);display:inline-block}

/* ---------- header ---------- */
header{
  position:sticky;top:0;z-index:50;
  background:rgba(241,244,242,.85);backdrop-filter:blur(12px);
  border-bottom:1px solid var(--mist);
}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.mark{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:700;font-size:18px;text-decoration:none}
.mark .dot{width:12px;height:12px;border-radius:3px;background:var(--pine);position:relative}
.mark .dot::after{content:"";position:absolute;inset:-4px -4px 4px 4px;border-radius:3px;background:var(--amber);z-index:-1}
.nav-links{display:flex;gap:26px;font-size:14px;font-weight:500}
.nav-links a{text-decoration:none;color:var(--slate);transition:color .15s}
.nav-links a:hover,.nav-links a:focus-visible{color:var(--pine)}
.nav-cta{
  background:var(--pine);color:#fff;padding:9px 18px;border-radius:999px;
  text-decoration:none;font-size:14px;font-weight:600;transition:background .15s;
}
.nav-cta:hover{background:var(--pine-deep)}
@media(max-width:760px){.nav-links{display:none}}

/* ---------- hero ---------- */
.hero{padding:88px 0 72px}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}}
.hero h1{font-size:clamp(38px,5.4vw,62px);font-weight:700}
.hero h1 em{font-style:normal;color:var(--pine);position:relative;white-space:nowrap}
.hero h1 em::after{
  content:"";position:absolute;left:0;right:0;bottom:6px;height:10px;
  background:var(--amber-soft);z-index:-1;border-radius:3px;
}
.hero p.lead{margin:22px 0 32px;font-size:18px;color:var(--slate);max-width:52ch}
.cta-row{display:flex;gap:14px;flex-wrap:wrap}
.btn{
  display:inline-flex;align-items:center;gap:9px;
  padding:13px 24px;border-radius:999px;text-decoration:none;
  font-weight:600;font-size:15px;transition:transform .12s,background .15s,box-shadow .15s;
}
.btn:hover{transform:translateY(-1px)}
.btn-solid{background:var(--pine);color:#fff}
.btn-solid:hover{background:var(--pine-deep);box-shadow:0 10px 24px rgba(20,85,74,.25)}
.btn-line{border:1.5px solid var(--ink);color:var(--ink)}
.btn-line:hover{background:var(--ink);color:var(--paper)}
.btn svg{width:18px;height:18px;flex:none}

/* signature: live dashboard card */
.dash{
  background:var(--card);border:1px solid var(--mist);border-radius:var(--radius);
  box-shadow:0 24px 60px rgba(16,34,31,.12);overflow:hidden;
}
.dash-bar{
  display:flex;align-items:center;gap:8px;padding:12px 16px;
  border-bottom:1px solid var(--mist);background:#fbfcfb;
}
.dash-bar i{width:10px;height:10px;border-radius:50%;background:var(--mist)}
.dash-bar i:first-child{background:var(--amber)}
.dash-bar span{font-family:var(--font-mono);font-size:11px;color:var(--slate);margin-left:6px}
.dash-body{padding:20px}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}
.kpi{background:var(--paper);border-radius:12px;padding:12px 14px}
.kpi small{font-family:var(--font-mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--slate)}
.kpi strong{display:block;font-family:var(--font-display);font-size:22px;margin-top:2px}
.kpi .up{color:var(--pine);font-size:11px;font-weight:600}
.chart-wrap{position:relative;background:var(--paper);border-radius:12px;padding:14px}
.chart-wrap svg{width:100%;height:auto;display:block}
.spark-line{fill:none;stroke:var(--pine);stroke-width:2.5;stroke-linecap:round;
  stroke-dasharray:600;stroke-dashoffset:600;animation:draw 2.2s .4s ease-out forwards}
.spark-fill{fill:url(#g);opacity:0;animation:fadein 1s 1.6s forwards}
.spark-dot{fill:var(--amber);opacity:0;animation:fadein .4s 2.4s forwards}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes fadein{to{opacity:1}}
.dash-rows{margin-top:14px;display:grid;gap:8px}
.dash-row{display:flex;justify-content:space-between;align-items:center;font-size:13px;
  background:var(--paper);border-radius:10px;padding:9px 12px}
.dash-row b{font-weight:600}
.pill{font-family:var(--font-mono);font-size:10px;padding:3px 8px;border-radius:999px;background:#e4efe9;color:var(--pine)}
.pill.warn{background:var(--amber-soft);color:#8a5d13}

/* ---------- proof strip ---------- */
.strip{border-top:1px solid var(--mist);border-bottom:1px solid var(--mist);padding:22px 0;background:var(--card)}
.strip .wrap{display:flex;flex-wrap:wrap;gap:12px 36px;justify-content:center;
  font-family:var(--font-mono);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--slate)}
.strip span::before{content:"◆";color:var(--amber);margin-right:10px;font-size:9px;vertical-align:2px}

/* ---------- story / journey ---------- */
.story-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:64px;margin-top:44px}
@media(max-width:900px){.story-grid{grid-template-columns:1fr}}
.portrait{
  position:relative;border-radius:var(--radius);overflow:hidden;
  aspect-ratio:4/5;background:var(--pine-deep);max-width:400px;
}
.portrait img{width:100%;height:100%;object-fit:cover;display:block}
.portrait .mono{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-family:var(--font-display);font-size:120px;font-weight:700;color:rgba(255,255,255,.9);
  background:linear-gradient(150deg,var(--pine) 0%,var(--pine-deep) 70%);
}
.portrait .badge{
  position:absolute;left:16px;bottom:16px;background:rgba(255,255,255,.94);
  border-radius:12px;padding:10px 14px;font-size:13px;font-weight:600;
  display:flex;align-items:center;gap:8px;
}
.portrait .badge i{width:9px;height:9px;border-radius:50%;background:var(--pine);
  box-shadow:0 0 0 3px rgba(20,85,74,.2)}
.story-copy p{color:var(--slate);margin-bottom:16px;font-size:16.5px}
.story-copy p strong{color:var(--ink)}
.timeline{margin-top:30px;display:grid;gap:0}
.tl{display:grid;grid-template-columns:22px 1fr;gap:16px;position:relative;padding-bottom:26px}
.tl:last-child{padding-bottom:0}
.tl::before{content:"";position:absolute;left:10px;top:20px;bottom:0;width:2px;background:var(--mist)}
.tl:last-child::before{display:none}
.tl i{width:22px;height:22px;border-radius:50%;background:var(--card);border:2px solid var(--pine);
  display:flex;align-items:center;justify-content:center;flex:none;margin-top:2px}
.tl i::after{content:"";width:8px;height:8px;border-radius:50%;background:var(--amber)}
.tl h3{font-size:17px;margin-bottom:4px}
.tl p{font-size:14.5px;color:var(--slate)}

/* ---------- projects ---------- */
.projects{background:var(--ink);color:var(--paper)}
.projects .eyebrow{color:var(--amber)}
.projects h2{color:#fff}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:44px}
.sec-head h2{font-size:clamp(30px,4vw,44px);max-width:20ch;margin-top:14px}
.sec-head p{color:var(--slate);max-width:44ch}
.projects .sec-head p{color:#9db3ad}
.proj-grid{display:grid;gap:20px}
.proj{
  background:#182e2a;border:1px solid #24413b;border-radius:var(--radius);
  padding:34px;display:grid;grid-template-columns:1fr 220px;gap:28px;align-items:center;
  transition:border-color .2s,transform .2s;
}
.proj:hover{border-color:var(--amber);transform:translateY(-2px)}
@media(max-width:760px){.proj{grid-template-columns:1fr}}
.proj .tag{font-family:var(--font-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--amber)}
.proj h3{font-size:24px;margin:10px 0 10px;color:#fff}
.proj p{color:#9db3ad;font-size:15px;margin-bottom:16px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{font-size:12.5px;padding:5px 12px;border-radius:999px;border:1px solid #2c4d46;color:#c4d6d0}
.chip-light{border-color:var(--mist);color:var(--slate);background:var(--card)}
.proj-art{border-radius:14px;background:#10221f;border:1px solid #24413b;padding:16px;min-height:150px;
  display:flex;flex-direction:column;justify-content:center;gap:10px}
.bar-row{display:flex;align-items:center;gap:10px;font-family:var(--font-mono);font-size:10px;color:#7e968f}
.bar{height:9px;border-radius:99px;background:var(--pine);flex:none}
.proj-art .amberbar{background:var(--amber)}
.grid-art{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.cell{aspect-ratio:1;border-radius:8px;background:#182e2a;border:1px solid #24413b}
.cell.on{background:var(--pine)}
.cell.hot{background:var(--amber)}
.ticket{background:#182e2a;border:1px solid #24413b;border-radius:10px;padding:8px 12px;
  font-family:var(--font-mono);font-size:10.5px;color:#c4d6d0;display:flex;justify-content:space-between}
.ticket em{font-style:normal;color:var(--amber)}

/* ---------- services ---------- */
.svc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:44px}
@media(max-width:760px){.svc-grid{grid-template-columns:1fr}}
.svc{
  background:var(--card);border:1px solid var(--mist);border-radius:var(--radius);
  padding:30px;transition:box-shadow .2s,transform .2s;
}
.svc:hover{box-shadow:0 18px 44px rgba(16,34,31,.1);transform:translateY(-2px)}
.svc .ic{
  width:46px;height:46px;border-radius:13px;background:var(--pine);
  display:flex;align-items:center;justify-content:center;margin-bottom:18px;
}
.svc .ic svg{width:22px;height:22px;stroke:#fff}
.svc h3{font-size:20px;margin-bottom:8px}
.svc p{color:var(--slate);font-size:15px}
.svc ul{margin-top:12px;list-style:none;display:grid;gap:6px}
.svc li{font-size:14px;color:var(--slate);display:flex;gap:9px}
.svc li::before{content:"→";color:var(--amber);font-weight:700}

/* ---------- process ---------- */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
@media(max-width:760px){.steps{grid-template-columns:1fr}}
.step{border-top:3px solid var(--pine);background:var(--card);border-radius:0 0 var(--radius) var(--radius);padding:26px}
.step b{font-family:var(--font-mono);font-size:12px;color:var(--amber);letter-spacing:.12em}
.step h3{font-size:19px;margin:8px 0 8px}
.step p{font-size:14.5px;color:var(--slate)}

/* ---------- contact ---------- */
.contact{background:var(--pine-deep);color:#fff;border-radius:28px;margin:0 24px 96px;padding:80px 24px;text-align:center}
.contact h2{font-size:clamp(30px,4.4vw,48px);max-width:22ch;margin:16px auto 14px;color:#fff}
.contact p{color:#b9d0ca;max-width:52ch;margin:0 auto 34px;font-size:17px}
.contact .eyebrow{justify-content:center;color:var(--amber)}
.contact .btn-wa{background:#25d366;color:#08301f}
.contact .btn-wa:hover{box-shadow:0 12px 30px rgba(37,211,102,.35)}
.contact .btn-li{background:#fff;color:var(--pine-deep)}
.contact .cta-row{justify-content:center}

footer{padding:34px 0 44px;text-align:center;color:var(--slate);font-size:13.5px}
footer b{font-family:var(--font-display)}

/* reveal on scroll */
.reveal{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .reveal{opacity:1;transform:none;transition:none}
  .spark-line{animation:none;stroke-dashoffset:0}
  .spark-fill,.spark-dot{animation:none;opacity:1}
  html{scroll-behavior:auto}
}
:focus-visible{outline:3px solid var(--amber);outline-offset:2px;border-radius:6px}
</style>
</head>
